# بيانات البوابة (الحساب الرسمي)
SSO_USERNAME=اسم_المستخدم
SSO_PASSWORD=كلمة_المرور

# بيانات علاقات العملاء (Dynamics CRM - تسجيل دخول ADFS منفصل، المستخدم بصيغة البريد)
CRM_USERNAME=بريد_المستخدم@الجهة.gov.sa
CRM_PASSWORD=كلمة_المرور

# بيانات الإرسال عبر Office 365
SMTP_SENDER=بريد_المرسل@الجهة.gov.sa
SMTP_PASSWORD=كلمة_مرور_التطبيق_او_كلمة_المرور

# بريد استقبال رمز التحقق (اتركه فارغاً إذا كان نفس بريد الإرسال)
OTP_IMAP_EMAIL=
OTP_IMAP_PASSWORD=

# اختياري: مسار مختلف لملف إعدادات الإدارات (لأغراض الاختبار)
# DEPT_SETTINGS_FILE=path/to/email_list.xlsx
